# Copy this file to .env.local (git-ignored) and fill in real values,
# or run `vercel env pull .env.local` after setting these in the Vercel
# dashboard. Never commit real values.

# Shared login password for the /admin page.
ADMIN_PASSWORD=

# Signing key for admin session tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_TOKEN_SECRET=

# Fine-grained GitHub PAT, scoped to only this repo, Contents: Read & write.
# Create at https://github.com/settings/personal-access-tokens
GITHUB_TOKEN=

# Repo the admin page commits photos/manifest changes into.
GITHUB_OWNER=coreydd2002
GITHUB_REPO=annettedicksonphotography
GITHUB_BRANCH=main
