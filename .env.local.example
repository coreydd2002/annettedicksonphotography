# Copy this file to .env.local (git-ignored) and fill in real values,
# or run `vercel env pull .env.local` after setting these in the Vercel
# dashboard. Never commit real values.

# Shared login password for the /admin page.
ADMIN_PASSWORD=

# Signing key for admin session tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_TOKEN_SECRET=

# CockroachDB Serverless connection string (Postgres wire-protocol
# compatible). Copy from the CockroachDB Cloud console's "Connect" dialog —
# it already includes ?sslmode=verify-full. Run db/schema.sql against this
# database once before first use.
DATABASE_URL=

# Vercel Blob read/write token — auto-added to the project's env vars once
# a Blob store is created and connected (Vercel dashboard -> Storage ->
# Blob). Required by api/admin/blob-upload.js (client upload tokens) and
# api/admin/publish.js (deleting orphaned blobs). Must be named exactly
# BLOB_READ_WRITE_TOKEN — the @vercel/blob SDK reads this env var by
# default and isn't told a different name anywhere in this codebase.
BLOB_READ_WRITE_TOKEN=

# Resend API key used by /api/contact to send the "Book Now" form as an
# email. Create at https://resend.com/api-keys. The from-address domain
# (annettedickson.photography) must be a verified sending domain in Resend.
RESEND_API_KEY=
